<div class="container px-5 px-sm-0">
  <div class="row">

    <div class="col-md-3">
      <%= render "info", user: @user, book: @book %>
    </div>

    <div class="col-md-8 offset-md-1">

      <h2>Books</h2>

      <table class="table table-hover">

        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </thead>

        <tbody>

          <% @books.each do |book| %>

            <tr>

              <td>
                <% if book.user.profile_image.attached? %>
                  <%= link_to user_path(book.user) do %>
                    <%= image_tag book.user.profile_image, size: "80x80",class: "img-thumbnail" %>
                  <% end %>
                <% else %>
                  <%= link_to "No Image", user_path(book.user) %>
                <% end %>
              </td>

              <td>
                <%= link_to book.title, book_path(book) %>
              </td>

              <td>
                <%= book.body %>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>
</div>